# -----------------------------------------------------------------------------
# Kalro Farm — Client environment
# -----------------------------------------------------------------------------
# Copy this file to `.env` and change the values below.
# Only variables starting with REACT_APP_ are exposed to the React bundle.
#
# IMPORTANT: These values are baked in at BUILD time.
#   - Local dev:  restart `npm start` (in the client folder) after editing.
#   - Railway:    change the env vars in the Railway service settings and
#                 trigger a redeploy (Railway will rebuild the client).
# -----------------------------------------------------------------------------

# --- Business identity (used across the site) --------------------------------
REACT_APP_BUSINESS_NAME=Kalro Farm Kenya
REACT_APP_BUSINESS_LOCATION=Naivasha, Kenya
REACT_APP_BUSINESS_EMAIL=info@kalrofarm.co.ke

# --- Phone / WhatsApp lines --------------------------------------------------
# Add up to 8 lines by incrementing the number in the variable name
# (REACT_APP_PHONE_1_*, REACT_APP_PHONE_2_*, ...). Only entries with a
# non-empty NUMBER are shown; delete a block to remove that line entirely.
#
# NUMBER accepts any Kenyan format: 0756908482, +254756908482, 254 756 908 482
# WHATSAPP is optional; set it if this line's WhatsApp number differs from
#   its call number. Leave it BLANK (e.g. REACT_APP_PHONE_2_WHATSAPP=) to hide
#   this line from the WhatsApp chooser (call-only line).
# DISPLAY is optional; falls back to a nicely-spaced international format.
# LABEL   is the short heading; SUBTITLE the one-line description.
# -----------------------------------------------------------------------------

# Line 1 — primary / office
REACT_APP_PHONE_1_LABEL=Main Line
REACT_APP_PHONE_1_SUBTITLE=Sales & orders
REACT_APP_PHONE_1_NUMBER=+254208224938
REACT_APP_PHONE_1_WHATSAPP=+254756908482
REACT_APP_PHONE_1_DISPLAY=020 822 4938

# Line 2 — branch / secondary
REACT_APP_PHONE_2_LABEL=Naivasha Branch
REACT_APP_PHONE_2_SUBTITLE=Poultry & eggs
REACT_APP_PHONE_2_NUMBER=+254756908482
REACT_APP_PHONE_2_WHATSAPP= +254756908482                       # inherits the NUMBER above
REACT_APP_PHONE_2_DISPLAY=+254 756 908 482        # auto-generated

# --- Google Maps (homepage location section) ---------------------------------
# Get a key from Google Cloud Console → APIs & Services → Credentials.
# Enable "Maps Embed API" for the iframe map on the homepage.
#
# REQUIRED for the embedded map:
#   REACT_APP_GOOGLE_MAPS_API_KEY
#
# OPTIONAL (defaults shown — adjust to your exact farm pin):
#   REACT_APP_GOOGLE_MAPS_LAT=-0.7167
#   REACT_APP_GOOGLE_MAPS_LNG=36.4333
#   REACT_APP_GOOGLE_MAPS_ZOOM=14
#   REACT_APP_GOOGLE_MAPS_QUERY=Kalro Farm Kenya, Naivasha
#   REACT_APP_GOOGLE_MAPS_TITLE=Visit Kalro Farm Kenya
#   REACT_APP_GOOGLE_MAPS_DESCRIPTION=Find us in Naivasha...
#   REACT_APP_GOOGLE_MAPS_HOURS=Mon–Sat: 8:00 AM – 6:00 PM
# -----------------------------------------------------------------------------
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_GOOGLE_MAPS_LAT=-0.7167
REACT_APP_GOOGLE_MAPS_LNG=36.4333
REACT_APP_GOOGLE_MAPS_ZOOM=14
REACT_APP_GOOGLE_MAPS_QUERY=Kalro Farm Kenya, Naivasha, Kenya

# --- Google AdSense (native in-feed ads on product listings) -----------------
# Native ads appear in the shop grid only — never on cart, checkout, or admin.
# Get your publisher id and ad unit ids from https://adsense.google.com
#
# REQUIRED to show ads:
#   REACT_APP_ADSENSE_ENABLED=true
#   REACT_APP_ADSENSE_CLIENT=ca-pub-8830279732074212
#   REACT_APP_ADSENSE_NATIVE_PRODUCTS_SLOT=1072594429
#
# OPTIONAL:
#   REACT_APP_ADSENSE_INTERVAL=10          # one ad after every N products
#   REACT_APP_ADSENSE_LAYOUT_KEY=-69+bu-l-1c+mw  # in-feed layout key from AdSense
#   REACT_APP_GOOGLE_SITE_VERIFICATION=          # optional meta-tag code from AdSense
#   REACT_APP_ADSENSE_CATEGORY_NATIVE_SLOT= # slot when viewing a category
#   REACT_APP_ADSENSE_SEARCH_NATIVE_SLOT=    # slot when search is active
#   REACT_APP_ADSENSE_BLOG_NATIVE_SLOT=      # reserved for future blog pages
# -----------------------------------------------------------------------------
REACT_APP_ADSENSE_ENABLED=false
REACT_APP_ADSENSE_CLIENT=ca-pub-8830279732074212
REACT_APP_ADSENSE_NATIVE_PRODUCTS_SLOT=1072594429
REACT_APP_ADSENSE_INTERVAL=10
REACT_APP_ADSENSE_LAYOUT_KEY=-69+bu-l-1c+mw
REACT_APP_ADSENSE_CATEGORY_NATIVE_SLOT=
REACT_APP_ADSENSE_SEARCH_NATIVE_SLOT=
REACT_APP_ADSENSE_BLOG_NATIVE_SLOT=

# -----------------------------------------------------------------------------
# Google Analytics 4 (GA4)
# Create a property at https://analytics.google.com → Admin → Data streams
# Measurement ID looks like G-XXXXXXXXXX
# -----------------------------------------------------------------------------
# REACT_APP_GA_ENABLED=true
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# REACT_APP_GA_ANONYMIZE_IP=true          # default true — recommended
# REACT_APP_GA_DEBUG=false                  # true = events in GA DebugView
# REACT_APP_GA_BUSINESS_NAME=Kalro Farm Kenya
# REACT_APP_GA_SITE_NAME=Kalro Farm Kenya
# REACT_APP_GA_CURRENCY=KES
REACT_APP_GA_ENABLED=false
REACT_APP_GA_MEASUREMENT_ID=
REACT_APP_GA_ANONYMIZE_IP=true
REACT_APP_GA_DEBUG=false
REACT_APP_GA_BUSINESS_NAME=Kalro Farm Kenya
REACT_APP_GA_SITE_NAME=Kalro Farm Kenya
REACT_APP_GA_CURRENCY=KES
