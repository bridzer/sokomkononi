# -----------------------------------------------------------------------------
# Kalro Farm — Client environment
# -----------------------------------------------------------------------------
# Copy this file to `.env` and change the values below.
# Only variables starting with REACT_APP_ are exposed to the React bundle.
#
# IMPORTANT: These values are baked in at BUILD time.
#   - Local dev:  restart `npm start` (in the client folder) after editing.
#   - Railway:    change the env vars in the Railway service settings and
#                 trigger a redeploy (Railway will rebuild the client).
# -----------------------------------------------------------------------------

# --- Business identity (used across the site) --------------------------------
REACT_APP_BUSINESS_NAME=Kalro Farm Kenya
REACT_APP_BUSINESS_LOCATION=Naivasha, Kenya
REACT_APP_BUSINESS_EMAIL=info@kalrofarm.co.ke

# --- Phone / WhatsApp lines --------------------------------------------------
# Add up to 8 lines by incrementing the number in the variable name
# (REACT_APP_PHONE_1_*, REACT_APP_PHONE_2_*, ...). Only entries with a
# non-empty NUMBER are shown; delete a block to remove that line entirely.
#
# NUMBER accepts any Kenyan format: 0756908482, +254756908482, 254 756 908 482
# WHATSAPP is optional; set it if this line's WhatsApp number differs from
#   its call number. Leave it BLANK (e.g. REACT_APP_PHONE_2_WHATSAPP=) to hide
#   this line from the WhatsApp chooser (call-only line).
# DISPLAY is optional; falls back to a nicely-spaced international format.
# LABEL   is the short heading; SUBTITLE the one-line description.
# -----------------------------------------------------------------------------

# Line 1 — primary / office
REACT_APP_PHONE_1_LABEL=Main Line
REACT_APP_PHONE_1_SUBTITLE=Sales & orders
REACT_APP_PHONE_1_NUMBER=+254208224938
REACT_APP_PHONE_1_WHATSAPP=+254756908482
REACT_APP_PHONE_1_DISPLAY=020 822 4938

# Line 2 — branch / secondary
REACT_APP_PHONE_2_LABEL=Naivasha Branch
REACT_APP_PHONE_2_SUBTITLE=Poultry & eggs
REACT_APP_PHONE_2_NUMBER=+254756908482
# REACT_APP_PHONE_2_WHATSAPP=                       # inherits the NUMBER above
# REACT_APP_PHONE_2_DISPLAY=+254 756 908 482        # auto-generated
