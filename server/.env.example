BUSINESS_LOCATION=Naivasha, Kenya

# Loop Payment Gateway (https://sandbox.loop.co.ke/devportal)
# Get credentials from the Loop developer portal — NEVER expose these to the client.
APP_BASE_URL=https://kalro.store
LOOP_API_BASE_URL=https://sandbox.loop.co.ke
LOOP_CLIENT_ID=
LOOP_CLIENT_SECRET=
LOOP_WEBHOOK_SECRET=
# LOOP_PAYMENT_INIT_PATH=/loop-api/1.0.0/payments/initiate
# LOOP_OAUTH_MODE=basic
#
# OPTION A (recommended): Cloud object storage — survives every deploy
# STORAGE_TYPE=s3
# S3_BUCKET=kalro-uploads
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# S3_FORCE_PATH_STYLE=true
#
# OPTION B: Railway Volume — mount at /app/server/uploads on your web service
# STORAGE_TYPE=local
# UPLOAD_DIR=/app/server/uploads
#
# Without Option A or B, uploaded images are LOST on every redeploy.
# STORAGE_TYPE=local
# UPLOAD_DIR=/app/server/uploads
