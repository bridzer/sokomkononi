# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Public site origin for Open Graph / payment callbacks (required in production)
APP_BASE_URL=http://localhost:3000

# PostgreSQL — use placeholders only in this file; never commit real credentials
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/kalro_farm
# or use individual params
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=kalro_farm

# JWT — use a long random string in every environment that faces the network
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin bootstrap (used by seed) — set a strong password; no default in production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=Soko Admin

# Business
WHATSAPP_NUMBER=254700000000
PHONE_NUMBER=0700000000
BUSINESS_EMAIL=info@example.com
BUSINESS_LOCATION=Naivasha, Kenya

# Loop Payment Gateway (https://sandbox.loop.co.ke/devportal)
# Get credentials from the Loop developer portal — NEVER expose these to the client.
LOOP_API_BASE_URL=https://sandbox.loop.co.ke
LOOP_CLIENT_ID=
LOOP_CLIENT_SECRET=
LOOP_API_KEY=
# REQUIRED when accepting Loop webhooks — callbacks are rejected if unset/placeholder
LOOP_WEBHOOK_SECRET=CHANGE_ME_webhook_hmac_secret
# LOOP_PAYMENT_INIT_PATH=/loop-api/1.0.0/payments/initiate
# LOOP_OAUTH_MODE=basic
#
# OPTION A — Railway Storage Bucket (recommended on Railway)
# 1. Create a Bucket in your Railway project
# 2. Web service → Variables → Variable Reference → pick bucket → AWS SDK preset
# 3. Set STORAGE_TYPE=s3 and reference bucket credentials (see README)
STORAGE_TYPE=s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://example.com/uploads
# S3_FORCE_PATH_STYLE=true   # only if bucket Credentials tab says path-style
#
# OPTION B — Cloudflare R2 / other S3-compatible storage
# STORAGE_TYPE=s3
# S3_BUCKET=kalro-uploads
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# S3_FORCE_PATH_STYLE=true
#
# OPTION C — Railway Volume (local disk, no bucket)
# STORAGE_TYPE=local
# UPLOAD_DIR=/app/server/uploads
#
# Without persistent storage, uploaded images are LOST on every redeploy.

# Google Analytics 4 — optional server-side gtag inject (works without client rebuild)
# GA_ENABLED=true
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_ANONYMIZE_IP=true
# GA_DEBUG=false
